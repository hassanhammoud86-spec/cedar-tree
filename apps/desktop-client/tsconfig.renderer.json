{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/renderer/**/*.ts"]
}
